# Supabase Configuration (Optional for Cloud persistence & Realtime)
# Used when deploying to Vercel + Supabase or using external Supabase instance
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
